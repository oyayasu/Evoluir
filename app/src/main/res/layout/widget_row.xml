<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="34dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <TextView
        android:id="@+id/row_dot"
        android:layout_width="23dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:text="●"
        android:textSize="18sp"
        android:textColor="#90958E" />
    <TextView
        android:id="@+id/row_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#202720"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/row_fail"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="✕"
        android:textColor="#B84240"
        android:contentDescription="Falhei"
        android:textStyle="bold"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/row_pass"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="✓"
        android:textColor="#358653"
        android:contentDescription="Superei"
        android:textStyle="bold"
        android:textSize="18sp" />
</LinearLayout>
