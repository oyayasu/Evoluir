<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="40dp"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <ImageView
        android:id="@+id/row_icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_marginEnd="9dp"
        android:src="@drawable/ic_sprout"
        android:contentDescription="Indicador" />
    <TextView
        android:id="@+id/row_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#27302B"
        android:textSize="12sp" />
    <TextView
        android:id="@+id/row_fail"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="✕"
        android:textColor="#B84240"
        android:contentDescription="Falhei"
        android:textStyle="bold"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/row_pass"
        android:layout_width="34dp"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="✓"
        android:textColor="#358653"
        android:contentDescription="Superei"
        android:textStyle="bold"
        android:textSize="18sp" />
</LinearLayout>